{
    "name": "electrik/slate-blocks",
    "description": "Curated Blade UI blocks for Electrik Slate — marketing, auth, application sections, and animated illustrations composed from Slate primitives.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "blade",
        "ui",
        "blocks",
        "electrik",
        "slate",
        "tailwind"
    ],
    "authors": [
        {
            "name": "neerajsohal",
            "email": "hello@electrik.dev"
        }
    ],
    "homepage": "https://github.com/electrikhq/slate-blocks",
    "support": {
        "issues": "https://github.com/electrikhq/slate-blocks/issues",
        "source": "https://github.com/electrikhq/slate-blocks"
    },
    "version": "0.2.0",
    "require": {
        "php": "^8.3",
        "electrik/slate": "^3.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Electrik\\SlateBlocks\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Electrik\\SlateBlocks\\SlateBlocksServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
